# Copy to .env. Never commit real secrets. The API key stays server-side.
BDT_MODE=demo
BDT_DB=data/bdt.sqlite3
BEARING_GEOMETRY=synthetic
EXPLAIN_METHOD=proxy
LLM_PROVIDER=template
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Comma-separated origins allowed to call the API from another host (leave empty when the dashboard is served by the API)
CORS_ORIGINS=
